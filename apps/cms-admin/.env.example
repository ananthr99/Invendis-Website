# Copy this file to .env and fill in real values. .env is git-ignored.

# Azure AD app registration (see comments in src/auth/msalConfig.js)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=

# Which repo the CMS reads from / writes to
VITE_GH_OWNER=your-github-username
VITE_GH_REPO=invendis-website
